
{%- doc -%}
  Checkout button for product forms. Adds the selected variant to cart and redirects to checkout.

  @param {string} can_add_to_cart - Whether the product can be added to the cart
{%- enddoc -%}

{% liquid
  assign class = 'checkout-button ' | append: block.settings.style_class
  assign id = 'BuyButtons-CheckoutButton-' | append: block.id
%}

<span
  {{ block.shopify_attributes }}
  style="--add-to-cart-font-case: {{ settings.button_text_case }};"
>
  <button
    id="{{ id }}"
    type="button"
    class="button {{ class }}"
    on:click="/handleCheckoutClick"
    data-testid="product-checkout-button"
    {% unless can_add_to_cart %}
      disabled
    {% endunless %}
  >
    <span class="button-text">{{ 'content.checkout' | t }}</span>
  </button>
</span>

{% schema %}
{
  "name": "t:names.checkout_button",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "style_class",
      "label": "t:settings.style",
      "options": [
        {
          "value": "button",
          "label": "t:options.primary"
        },
        {
          "value": "button-secondary",
          "label": "t:options.secondary"
        }
      ],
      "default": "button-secondary"
    }
  ]
}
{% endschema %}
