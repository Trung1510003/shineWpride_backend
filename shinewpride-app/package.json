{
  "name": "shinewpride-app",
  "private": true,
  "scripts": {
    "build": "remix vite:build && npm run build:worker",
    "build:worker": "esbuild app/worker.server.ts --bundle --platform=node --target=node20 --outfile=build/worker.js --format=esm --packages=external",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "shopify app deploy",
    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "remix-serve ./build/server/index.js",
    "docker-start": "npm run setup && EMAIL_SCHEDULER_ENABLED=true npm run start",
    "docker-start:web": "npm run setup && APP_PROCESS_ROLE=web EMAIL_SCHEDULER_ENABLED=false npm run start",
    "docker-start:worker": "npm run setup && EMAIL_SCHEDULER_ENABLED=true node build/worker.js",
    "setup": "prisma generate && prisma migrate deploy",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@remix-run/dev": "^2.16.1",
    "@remix-run/fs-routes": "^2.16.1",
    "@remix-run/node": "^2.16.1",
    "@remix-run/react": "^2.16.1",
    "@remix-run/serve": "^2.16.1",
    "@shopify/app-bridge-react": "^4.1.6",
    "@shopify/cli": "4.3.0",
    "@shopify/polaris": "^12.0.0",
    "@shopify/shopify-app-remix": "^4.1.0",
    "@shopify/shopify-app-session-storage-prisma": "^8.0.0",
    "bullmq": "^5.79.2",
    "ioredis": "5.10.1",
    "isbot": "^5.1.0",
    "node-cron": "^4.5.0",
    "pino": "^10.3.1",
    "prisma": "^6.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "resend": "^6.16.0",
    "sharp": "^0.35.2",
    "vite-tsconfig-paths": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@remix-run/eslint-config": "^2.16.1",
    "@remix-run/route-config": "^2.16.1",
    "@shopify/api-codegen-preset": "^1.1.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^22.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.2.31",
    "@types/react-dom": "^18.2.14",
    "esbuild": "^0.25.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.2.4",
    "typescript": "^5.2.2",
    "vite": "^6.2.2",
    "vitest": "^4.1.9"
  },
  "workspaces": [
    "extensions/*"
  ],
  "trustedDependencies": [
    "@shopify/plugin-cloudflare"
  ],
  "resolutions": {
    "@graphql-tools/url-loader": "8.0.16",
    "@graphql-codegen/client-preset": "4.7.0",
    "@graphql-codegen/typescript-operations": "4.5.0",
    "minimatch": "9.0.5",
    "vite": "^6.2.2",
    "ioredis": "5.10.1",
    "@shopify/shopify-api": "13.1.0"
  },
  "overrides": {
    "@graphql-tools/url-loader": "8.0.16",
    "@graphql-codegen/client-preset": "4.7.0",
    "@graphql-codegen/typescript-operations": "4.5.0",
    "minimatch": "9.0.5",
    "vite": "^6.2.2",
    "ioredis": "5.10.1",
    "@shopify/shopify-api": "13.1.0"
  },
  "author": "trung"
}
