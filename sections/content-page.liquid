{{ 'content-page.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign page_title = page.title
  if page_title == blank
    assign page_title = section.settings.title
  endif
  assign layout_class = 'content-page'
  if section.settings.wide_layout
    assign layout_class = layout_class | append: ' content-page--wide'
  endif
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="section section--page-width color-{{ section.settings.color_scheme }}">
  <div
    class="spacing-style {{ layout_class }}"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {%- if section.settings.show_header -%}
      <header class="content-page__header">
        <h1 class="content-page__title">{{ page_title }}</h1>
        {%- if section.settings.intro != blank -%}
          <p class="content-page__intro">{{ section.settings.intro }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="content-page__blocks">
      {%- liquid
        assign in_faq_group = false
      -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq' -%}
          {%- unless in_faq_group -%}
            <div class="content-page__faq">
            {%- assign in_faq_group = true -%}
          {%- endunless -%}
          <details class="content-page__faq-item" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}</summary>
            <div class="content-page__faq-answer rte">{{ block.settings.answer }}</div>
          </details>
        {%- else -%}
          {%- if in_faq_group -%}
            </div>
            {%- assign in_faq_group = false -%}
          {%- endif -%}

          {%- case block.type -%}
            {%- when 'heading' -%}
              <div class="content-page__block" {{ block.shopify_attributes }}>
                <h2 class="content-page__heading">{{ block.settings.heading }}</h2>
              </div>

            {%- when 'text' -%}
              <div class="content-page__block content-page__text rte" {{ block.shopify_attributes }}>
                {{ block.settings.body }}
              </div>

            {%- when 'callout' -%}
              <div class="content-page__callout rte" {{ block.shopify_attributes }}>
                {{ block.settings.body }}
              </div>

            {%- when 'contact_info' -%}
              <div class="content-page__contact-grid" {{ block.shopify_attributes }}>
                {%- if block.settings.email != blank -%}
                  <div class="content-page__contact-card">
                    <p class="content-page__contact-label">{{ block.settings.email_label | default: 'Email' }}</p>
                    <p class="content-page__contact-value">
                      <a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
                    </p>
                  </div>
                {%- endif -%}
                {%- if block.settings.phone != blank -%}
                  <div class="content-page__contact-card">
                    <p class="content-page__contact-label">{{ block.settings.phone_label | default: 'Phone' }}</p>
                    <p class="content-page__contact-value">
                      <a href="tel:{{ block.settings.phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}">{{ block.settings.phone }}</a>
                    </p>
                  </div>
                {%- endif -%}
                {%- if block.settings.hours != blank -%}
                  <div class="content-page__contact-card">
                    <p class="content-page__contact-label">{{ block.settings.hours_label | default: 'Hours' }}</p>
                    <p class="content-page__contact-value">{{ block.settings.hours | newline_to_br }}</p>
                  </div>
                {%- endif -%}
                {%- if block.settings.address != blank -%}
                  <div class="content-page__contact-card">
                    <p class="content-page__contact-label">{{ block.settings.address_label | default: 'Address' }}</p>
                    <p class="content-page__contact-value">{{ block.settings.address | newline_to_br }}</p>
                  </div>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if in_faq_group -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Content page",
  "tag": "section",
  "class": "content-page-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Fallback title",
      "info": "Used when no Shopify page title is available"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show page header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "wide_layout",
      "label": "Wide layout",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Section heading"
        }
      ]
    },
    {
      "type": "text",
      "name": "Rich text",
      "settings": [
        {
          "type": "richtext",
          "id": "body",
          "label": "Content",
          "default": "<p>Add your content here.</p>"
        }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer goes here.</p>"
        }
      ]
    },
    {
      "type": "callout",
      "name": "Callout box",
      "settings": [
        {
          "type": "richtext",
          "id": "body",
          "label": "Content",
          "default": "<p><strong>Note:</strong> Important information for customers.</p>"
        }
      ]
    },
    {
      "type": "contact_info",
      "name": "Contact details",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "email",
          "label": "Email",
          "default": "hello@shinewpride.com"
        },
        {
          "type": "text",
          "id": "email_label",
          "label": "Email label",
          "default": "Email"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone",
          "default": "+1 (555) 123-4567"
        },
        {
          "type": "text",
          "id": "phone_label",
          "label": "Phone label",
          "default": "Phone"
        },
        {
          "type": "textarea",
          "id": "hours",
          "label": "Business hours",
          "default": "Mon–Fri: 9am – 6pm EST\nSat–Sun: Closed"
        },
        {
          "type": "text",
          "id": "hours_label",
          "label": "Hours label",
          "default": "Hours"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address",
          "default": "ShineWpride\n123 Pride Avenue\nNew York, NY 10001\nUnited States"
        },
        {
          "type": "text",
          "id": "address_label",
          "label": "Address label",
          "default": "Address"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Content page"
    }
  ]
}
{% endschema %}
