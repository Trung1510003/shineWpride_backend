
{{ 'artistry-marketplace.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign shop_url = section.settings.shop_link | default: routes.all_products_collection_url
  assign collections_url = section.settings.collections_link | default: routes.collections_url
  assign new_arrivals_url = section.settings.new_arrivals_link | default: shop_url
  assign sale_url = section.settings.sale_link | default: shop_url
  assign contact_url = section.settings.contact_link | default: '/pages/contact'
  assign faq_url = section.settings.faq_link | default: '/pages/faq'
  assign shipping_url = section.settings.shipping_link | default: '/pages/shipping-policy'
  assign returns_url = section.settings.returns_link | default: '/pages/refund-policy'
  assign about_url = section.settings.about_link
  if about_url == blank
    assign about_page = pages['about-us']
    if about_page != blank
      assign about_url = about_page.url
    else
      assign about_url = routes.root_url
    endif
  endif
  assign privacy_url = section.settings.privacy_link | default: '/pages/privacy-policy'
  assign terms_url = section.settings.terms_link | default: '/pages/terms-of-service'
  assign careers_url = section.settings.careers_link | default: about_url
-%}

<div class="am-footer">
  <div class="am-footer__inner rb-home-shell">
    <div class="am-footer__grid">
      <div class="am-footer__column">
        {%- if section.settings.brand_name != blank -%}
          <h3 class="am-footer__brand">{{ section.settings.brand_name }}</h3>
        {%- endif -%}
        {%- if section.settings.brand_text != blank -%}
          <p class="am-footer__brand-text">{{ section.settings.brand_text }}</p>
        {%- endif -%}
      </div>

      <div class="am-footer__column">
        <h4 class="am-footer__heading">{{ section.settings.shop_heading }}</h4>
        <ul class="am-footer__links">
          <li><a href="{{ shop_url }}">{{ section.settings.all_products_label }}</a></li>
          <li><a href="{{ new_arrivals_url }}">{{ section.settings.new_arrivals_label }}</a></li>
          <li><a href="{{ sale_url }}">{{ section.settings.sale_label }}</a></li>
          <li><a href="{{ collections_url }}">{{ section.settings.collections_label }}</a></li>
        </ul>
      </div>

      <div class="am-footer__column">
        <h4 class="am-footer__heading">{{ section.settings.support_heading }}</h4>
        <ul class="am-footer__links">
          <li><a href="{{ contact_url }}">{{ section.settings.contact_label }}</a></li>
          <li><a href="{{ faq_url }}">{{ section.settings.faq_label }}</a></li>
          <li><a href="{{ shipping_url }}">{{ section.settings.shipping_label }}</a></li>
          <li><a href="{{ returns_url }}">{{ section.settings.returns_label }}</a></li>
        </ul>
      </div>

      <div class="am-footer__column">
        <h4 class="am-footer__heading">{{ section.settings.company_heading }}</h4>
        <ul class="am-footer__links">
          <li><a href="{{ about_url }}">{{ section.settings.about_label }}</a></li>
          <li><a href="{{ privacy_url }}">{{ section.settings.privacy_label }}</a></li>
          <li><a href="{{ terms_url }}">{{ section.settings.terms_label }}</a></li>
          <li><a href="{{ careers_url }}">{{ section.settings.careers_label }}</a></li>
        </ul>
      </div>
    </div>

    <div class="am-footer__bottom">
      {%- assign copyright_year = 'now' | date: '%Y' -%}
      <p class="am-footer__copyright">{{ section.settings.copyright_text | replace: '[year]', copyright_year }}</p>
    </div>
  </div>
</div>

