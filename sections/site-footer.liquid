{{ 'site-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign about_url = '/pages/about-us'
  assign about_page = pages['about-us']
  if about_page != blank
    assign about_url = about_page.url
  endif
-%}

<footer class="site-footer-rb" id="site-footer">
  <div class="site-footer-rb__inner">
    <div class="site-footer-rb__newsletter">
      {%- if section.settings.newsletter_heading != blank -%}
        <h2 class="site-footer-rb__heading">{{ section.settings.newsletter_heading }}</h2>
      {%- endif -%}
      {%- if section.settings.newsletter_text != blank -%}
        <p class="site-footer-rb__text">{{ section.settings.newsletter_text }}</p>
      {%- endif -%}

      {% form 'customer', class: 'site-footer-rb__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="FooterNewsletterEmail-{{ section.id }}">Email</label>
        <input
          id="FooterNewsletterEmail-{{ section.id }}"
          class="site-footer-rb__input"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          placeholder="{{ section.settings.newsletter_placeholder }}"
          required
          autocomplete="email"
          {% if form.errors %}
            aria-invalid="true"
          {% endif %}
        >
        <button type="submit" class="site-footer-rb__submit">
          {{ section.settings.newsletter_button_label }}
        </button>
      {% endform %}

      {%- if form.posted_successfully? -%}
        <p class="site-footer-rb__message site-footer-rb__message--success">{{ section.settings.newsletter_success_message }}</p>
      {%- elsif form.errors -%}
        <p class="site-footer-rb__message site-footer-rb__message--error">{{ form.errors.translated_fields.email | capitalize }}</p>
      {%- endif -%}
    </div>

    <div class="site-footer-rb__links">
      <div class="site-footer-rb__column">
        <h3 class="site-footer-rb__column-title">{{ section.settings.help_heading }}</h3>
        <ul class="site-footer-rb__menu">
          <li><a href="/pages/faq">FAQ</a></li>
          <li><a href="/pages/shipping-policy">Shipping Policy</a></li>
          <li><a href="/pages/refund-policy">Refund & Return Policy</a></li>
          <li><a href="/pages/contact">Contact</a></li>
        </ul>
      </div>

      <div class="site-footer-rb__column">
        <h3 class="site-footer-rb__column-title">{{ section.settings.company_heading }}</h3>
        <ul class="site-footer-rb__menu">
          <li><a href="{{ about_url }}">About Us</a></li>
          <li><a href="/pages/privacy-policy">Privacy Policy</a></li>
          <li><a href="/pages/terms-of-service">Terms of Service</a></li>
        </ul>
      </div>

      {%- if section.settings.show_shop_column -%}
        <div class="site-footer-rb__column">
          <h3 class="site-footer-rb__column-title">{{ section.settings.shop_heading }}</h3>
          <ul class="site-footer-rb__menu">
            <li><a href="{{ routes.all_products_collection_url }}">All Products</a></li>
            <li><a href="{{ routes.collections_url }}">Collections</a></li>
            {%- if section.settings.shop_link_label != blank and section.settings.shop_link_url != blank -%}
              <li><a href="{{ section.settings.shop_link_url }}">{{ section.settings.shop_link_label }}</a></li>
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}
    </div>

    <div class="site-footer-rb__bottom">
      <p class="site-footer-rb__copyright">
        &copy; {{ 'now' | date: '%Y' }}
        <a href="{{ routes.root_url }}">{{ shop.name }}</a>
        {%- if section.settings.show_powered_by -%}
          , {{ powered_by_link }}
        {%- endif -%}
      </p>

      {%- if shop.policies.size > 0 -%}
        <div class="site-footer-rb__bottom-center">
          <button
            type="button"
            class="site-footer-rb__policies-trigger button-unstyled"
            popovertarget="site-footer-policies-{{ section.id }}"
            popovertargetaction="toggle"
          >
            {{ 'content.terms_and_policies' | t }}
          </button>
          <div
            class="site-footer-rb__policies-popover"
            id="site-footer-policies-{{ section.id }}"
            popover="auto"
          >
            <ul class="site-footer-rb__policies-list">
              {%- for policy in shop.policies -%}
                {%- if policy != blank -%}
                  <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.show_social -%}
        <div class="site-footer-rb__bottom-end">
          <div class="site-footer-rb__social">
            {%- if section.settings.facebook_url != blank -%}
              <a class="site-footer-rb__social-link" href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                <svg aria-hidden="true" focusable="false" viewBox="0 0 20 20"><path d="M11.5 18.5v-6.2h2.1l.3-2.6H11.5V8.1c0-.8.2-1.3 1.3-1.3h1.4V4.4c-.2 0-1.1-.1-2.1-.1-2.1 0-3.5 1.3-3.5 3.6v2.1H6.5v2.6h2.1v6.2h2.9Z" fill="currentColor"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.instagram_url != blank -%}
              <a class="site-footer-rb__social-link" href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                <svg aria-hidden="true" focusable="false" viewBox="0 0 20 20"><path d="M10 6.1A3.9 3.9 0 1 0 10 13.9 3.9 3.9 0 0 0 10 6.1Zm0 6.4A2.5 2.5 0 1 1 10 7.5a2.5 2.5 0 0 1 0 5Zm4.9-6.6a.9.9 0 1 1-1.8 0 .9.9 0 0 1 1.8 0ZM14.8 4.6c-.3-.8-1-1.5-1.8-1.8-1.3-.5-4.3-.5-5.6 0-.8.3-1.5 1-1.8 1.8-.5 1.3-.5 4.3 0 5.6.3.8 1 1.5 1.8 1.8 1.3.5 4.3.5 5.6 0 .8-.3 1.5-1 1.8-1.8.5-1.3.5-4.3 0-5.6ZM10 15.4A5.4 5.4 0 0 1 4.6 10 5.4 5.4 0 0 1 10 4.6 5.4 5.4 0 0 1 15.4 10 5.4 5.4 0 0 1 10 15.4Z" fill="currentColor"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.tiktok_url != blank -%}
              <a class="site-footer-rb__social-link" href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
                <svg aria-hidden="true" focusable="false" viewBox="0 0 20 20"><path d="M13.7 4.6c.8 1 2 1.7 3.3 1.8v2.5c-1.2 0-2.3-.4-3.3-1.1v5.6c0 2.8-2.3 5.1-5.1 5.1S3.5 15.2 3.5 12.4s2.3-5.1 5.1-5.1c.3 0 .6 0 .9.1v2.6a2.6 2.6 0 1 0 1.8 2.5V4.6h2.4Z" fill="currentColor"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.youtube_url != blank -%}
              <a class="site-footer-rb__social-link" href="{{ section.settings.youtube_url }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
                <svg aria-hidden="true" focusable="false" viewBox="0 0 20 20"><path d="M17.6 6.4a2 2 0 0 0-1.4-1.4C14.8 4.6 10 4.6 10 4.6s-4.8 0-6.2.4A2 2 0 0 0 2.4 6.4 20.8 20.8 0 0 0 2 10c0 1.2.1 2.4.4 3.6a2 2 0 0 0 1.4 1.4c1.4.4 6.2.4 6.2.4s4.8 0 6.2-.4a2 2 0 0 0 1.4-1.4c.3-1.2.4-2.4.4-3.6 0-1.2-.1-2.4-.4-3.6ZM8.4 12.6V7.4L13 10l-4.6 2.6Z" fill="currentColor"/></svg>
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Site footer",
  "tag": "section",
  "class": "site-footer-section",
  "settings": [
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Join our email list"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Description",
      "default": "Get exclusive deals and early access to new products."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "newsletter_button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "newsletter_success_message",
      "label": "Success message",
      "default": "Thanks for subscribing!"
    },
    {
      "type": "header",
      "content": "Link columns"
    },
    {
      "type": "text",
      "id": "help_heading",
      "label": "Help column title",
      "default": "Help"
    },
    {
      "type": "text",
      "id": "company_heading",
      "label": "Company column title",
      "default": "Company"
    },
    {
      "type": "checkbox",
      "id": "show_shop_column",
      "label": "Show shop column",
      "default": false
    },
    {
      "type": "text",
      "id": "shop_heading",
      "label": "Shop column title",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "shop_link_label",
      "label": "Extra shop link label"
    },
    {
      "type": "url",
      "id": "shop_link_url",
      "label": "Extra shop link URL"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "Show Powered by Shopify",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    }
  ],
  "presets": [
    {
      "name": "Site footer",
      "category": "Footer"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
