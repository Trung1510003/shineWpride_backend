
{% if section.blocks.size > 1 %}
  {% assign autoplay_enabled = section.settings.autoplay %}
{% else %}
  {% assign autoplay_enabled = false %}
{% endif %}

{% capture controls %}
  {%- render 'slideshow-controls',
    style: section.settings.pagination_style,
    autoplay: autoplay_enabled,
    item_count: section.blocks.size,
    show_arrows: false,
    arrows_on_media: false,
    controls_on_media: true,
    pagination_position: 'center',
    icon_style: 'chevron',
    class: 'hero-banner__controls'
  -%}
{% endcapture %}

{% capture slides %}
  {% for block in section.blocks %}
    {% assign block_index = forloop.index0 %}
    {% render 'hero-banner-slide', block: block, section: section, block_index: block_index %}
  {% endfor %}
{% endcapture %}

<div class="hero-banner-section section disable-section-top-offset" id="hero-banner-{{ section.id }}" data-hero-height="{{ section.settings.slide_height }}">
  <div class="hero-banner-section__background"></div>

  <div class="hero-banner__frame">
    {% render 'slideshow',
      class: 'hero-banner',
      controls: controls,
      show_arrows: section.settings.show_arrows,
      icon_style: 'chevron',
      icon_shape: 'circle',
      arrows_position: 'center',
      autoplay: autoplay_enabled,
      autoplay_speed: section.settings.autoplay_speed,
      slides: slides,
      slide_count: section.blocks.size,
      slide_size: section.settings.slide_height,
      slide_position: 'stretch'
    %}

    <div class="hero-banner__pride-bar" aria-hidden="true"></div>
  </div>

  {% if section.settings.show_scroll_hint %}
    <div class="hero-banner__scroll-hint" aria-hidden="true">
      <span class="hero-banner__scroll-line"></span>
      <span class="hero-banner__scroll-text">Scroll</span>
    </div>
  {% endif %}
</div>

{{ 'hero-banner.css' | asset_url | stylesheet_tag }}

<script
  src="{{ 'hero-banner.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "class": "hero-banner-wrapper disable-section-top-offset",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "hero_slide",
      "name": "Slide",
      "settings": [
        {
          "type": "header",
          "content": "Media"
        },
        {
          "type": "select",
          "id": "media_type",
          "label": "Type",
          "options": [
            { "value": "image", "label": "Image" },
            { "value": "video", "label": "Video" }
          ],
          "default": "image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "visible_if": "{{ block.settings.media_type == 'image' }}"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "visible_if": "{{ block.settings.media_type == 'video' }}"
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "New Collection"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shine With Pride"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading",
          "default": "Authentic style. Unapologetic you."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open in new tab",
          "default": false
        },
        {
          "type": "select",
          "id": "content_alignment",
          "label": "Text alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content position",
          "options": [
            { "value": "center", "label": "Center" },
            { "value": "bottom", "label": "Bottom" }
          ],
          "default": "bottom"
        },
        {
          "type": "header",
          "content": "Overlay"
        },
        {
          "type": "checkbox",
          "id": "toggle_overlay",
          "label": "Show overlay",
          "default": true
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "Overlay color",
          "alpha": true,
          "default": "#00000099",
          "visible_if": "{{ block.settings.toggle_overlay }}"
        },
        {
          "type": "select",
          "id": "overlay_style",
          "label": "Overlay style",
          "options": [
            { "value": "gradient", "label": "Gradient" },
            { "value": "solid", "label": "Solid" }
          ],
          "default": "gradient",
          "visible_if": "{{ block.settings.toggle_overlay }}"
        },
        {
          "type": "select",
          "id": "gradient_direction",
          "label": "Gradient direction",
          "options": [
            { "value": "to top", "label": "Up" },
            { "value": "to bottom", "label": "Down" }
          ],
          "default": "to top",
          "visible_if": "{{ block.settings.toggle_overlay and block.settings.overlay_style == 'gradient' }}"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "slide_height",
      "label": "Height",
      "options": [
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "small", "label": "Small" }
      ],
      "default": "large"
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "select",
      "id": "pagination_style",
      "label": "Pagination",
      "options": [
        { "value": "dots", "label": "Dots" },
        { "value": "counter", "label": "Counter" },
        { "value": "none", "label": "None" }
      ],
      "default": "dots"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 6,
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_hint",
      "label": "Show scroll hint",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Hero banner",
      "blocks": {
        "slide_1": {
          "type": "hero_slide",
          "settings": {
            "media_type": "image",
            "eyebrow": "New Collection",
            "heading": "Shine With Pride",
            "subheading": "Authentic style. Unapologetic you.",
            "button_label": "Shop now",
            "button_link": "shopify://collections/all",
            "content_alignment": "center",
            "content_position": "bottom",
            "toggle_overlay": true,
            "overlay_color": "#00000080",
            "overlay_style": "gradient",
            "gradient_direction": "to top"
          }
        },
        "slide_2": {
          "type": "hero_slide",
          "settings": {
            "media_type": "video",
            "eyebrow": "Limited Drop",
            "heading": "Wear Your Colors",
            "subheading": "Bold pieces for every story.",
            "button_label": "Explore",
            "button_link": "shopify://collections/all",
            "content_alignment": "center",
            "content_position": "bottom",
            "toggle_overlay": true,
            "overlay_color": "#00000080",
            "overlay_style": "gradient",
            "gradient_direction": "to top"
          }
        }
      },
      "block_order": ["slide_1", "slide_2"]
    }
  ]
}
{% endschema %}
