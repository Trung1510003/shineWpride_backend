
{{ 'home-redbubble.css' | asset_url | stylesheet_tag }}

<div class="rb-trust">
  <div class="rb-trust__grid">
    {%- for block in section.blocks -%}
      <div class="rb-trust__item" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}
          <div class="rb-trust__icon">{{ block.settings.icon }}</div>
        {%- endif -%}
        {%- if block.settings.title != blank -%}
          <h3 class="rb-trust__title">{{ block.settings.title }}</h3>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <p class="rb-trust__text">{{ block.settings.text }}</p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Trust badges",
  "tag": "section",
  "class": "rb-trust-section",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "🌍"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Worldwide Shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "Available as standard or express delivery"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust badges",
      "category": "Footer",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "icon": "🌍",
            "title": "Worldwide Shipping",
            "text": "Available as standard or express delivery"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "🔒",
            "title": "Secure Payments",
            "text": "100% secure payment with SSL encryption"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "↩️",
            "title": "Free Return",
            "text": "Exchange or money back guarantee for all orders"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "💬",
            "title": "Local Support",
            "text": "24/7 dedicated support"
          }
        }
      ]
    }
  ]
}
{% endschema %}
