
{{ 'artistry-marketplace.css' | asset_url | stylesheet_tag }}

<div class="am-cta rb-home-shell">
  <div class="am-cta__card">
    {%- if section.settings.heading != blank -%}
      <h2 class="am-cta__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="am-cta__text">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a
        href="{{ section.settings.button_link | default: routes.root_url }}"
        class="am-cta__button"
      >
        <span>{{ section.settings.button_label }}</span>
        <svg class="am-cta__button-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Custom design CTA",
  "tag": "section",
  "class": "am-cta-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Create Your Custom Design"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Can't find what you're looking for? Design your own custom merchandise and share it with the world."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start Designing"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Custom design CTA",
      "category": "Text"
    }
  ]
}
{% endschema %}
