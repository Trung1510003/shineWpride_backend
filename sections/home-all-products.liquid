
{{ 'home-redbubble.css' | asset_url | stylesheet_tag }}
{{ 'home-catalog.css' | asset_url | stylesheet_tag }}

<section class="home-all-products rb-section" id="all-products">
  <div class="rb-section__header">
    <div>
      <h2 class="rb-section__title">{{ section.settings.heading }}</h2>
      {%- if collections.all.products_count > 0 -%}
        <p class="home-catalog__count">{{ collections.all.products_count }} products</p>
      {%- endif -%}
    </div>
    <a href="{{ routes.all_products_collection_url }}" class="rb-section__link">
      {{ section.settings.link_label }}
    </a>
  </div>

  {%- paginate collections.all.products by section.settings.max_products -%}
    {% render 'rb-product-grid', products: collections.all.products, limit: section.settings.max_products %}
  {%- endpaginate -%}

  <div class="home-catalog__view-all">
    <a href="{{ routes.all_products_collection_url }}" class="home-catalog__view-all-btn">
      {{ section.settings.button_label }}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "All products",
  "tag": "section",
  "class": "home-all-products-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All Products"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Header link label",
      "default": "View all"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop all products"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Products to show",
      "min": 8,
      "max": 50,
      "step": 2,
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "All products",
      "category": "Products"
    }
  ]
}
{% endschema %}
