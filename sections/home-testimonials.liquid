
{{ 'artistry-marketplace.css' | asset_url | stylesheet_tag }}

<div class="am-testimonials rb-home-shell">
  {%- if section.settings.heading != blank -%}
    <h2 class="am-testimonials__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="am-testimonials__grid">
    {%- for block in section.blocks -%}
      <article class="am-testimonial" {{ block.shopify_attributes }}>
        <div class="am-testimonial__stars" aria-hidden="true">
          {%- for i in (1..5) -%}
            <svg class="am-testimonial__star" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          {%- endfor -%}
        </div>
        {%- if block.settings.quote != blank -%}
          <blockquote class="am-testimonial__quote">{{ block.settings.quote }}</blockquote>
        {%- endif -%}
        {%- if block.settings.author != blank -%}
          <p class="am-testimonial__author">{{ block.settings.author }}</p>
        {%- endif -%}
        {%- if block.settings.subtitle != blank -%}
          <p class="am-testimonial__subtitle">{{ block.settings.subtitle }}</p>
        {%- endif -%}
      </article>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Customer testimonials",
  "tag": "section",
  "class": "am-testimonials-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by Artists & Customers"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The quality is amazing and the design came out perfect. I'm so impressed with my purchase!"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name",
          "default": "Verified Customer"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Verified Buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer testimonials",
      "category": "Text",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "The quality is amazing and the design came out perfect. I'm so impressed with my purchase!",
            "author": "Alex M.",
            "subtitle": "Verified Buyer"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Finally found pride merch that actually looks and feels premium. Will definitely order again!",
            "author": "Jordan K.",
            "subtitle": "Verified Buyer"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Ordered three items — every single one exceeded my expectations. ShineWpride is the real deal.",
            "author": "Sam O.",
            "subtitle": "Verified Buyer"
          }
        }
      ]
    }
  ]
}
{% endschema %}
