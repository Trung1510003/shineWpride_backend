
{{ 'home-bottom-nav.css' | asset_url | stylesheet_tag }}

<section class="home-newsletter" id="newsletter">
  <div class="home-newsletter__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="home-newsletter__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="home-newsletter__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {% form 'customer', class: 'home-newsletter__form' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">Email</label>
      <input
        id="NewsletterEmail-{{ section.id }}"
        class="home-newsletter__input"
        type="email"
        name="contact[email]"
        value="{{ form.email }}"
        placeholder="{{ section.settings.placeholder }}"
        required
        autocomplete="email"
        {% if form.errors %}
          aria-invalid="true"
        {% endif %}
      >
      <button type="submit" class="home-newsletter__submit">
        {{ section.settings.button_label }}
      </button>
    {% endform %}

    {%- if form.posted_successfully? -%}
      <p class="home-newsletter__message home-newsletter__message--success">{{ section.settings.success_message }}</p>
    {%- elsif form.errors -%}
      <p class="home-newsletter__message home-newsletter__message--error">{{ form.errors.translated_fields.email | capitalize }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter signup",
  "tag": "section",
  "class": "home-newsletter-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join our email list"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Get exclusive deals and early access to new products."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for subscribing!"
    }
  ],
  "presets": [
    {
      "name": "Newsletter signup",
      "category": "Forms"
    }
  ]
}
{% endschema %}
