
{{ 'home-redbubble.css' | asset_url | stylesheet_tag }}

<div class="rb-hero" id="rb-hero-{{ section.id }}">
  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 2000
      | image_tag:
        class: 'rb-hero__bg',
        loading: 'eager',
        fetchpriority: 'high',
        widths: '750, 1100, 1500, 2000',
        sizes: '100vw'
    }}
  {%- endif -%}
  <div class="rb-hero__overlay" aria-hidden="true"></div>
  <div class="rb-hero__content">
    {%- if section.settings.heading != blank -%}
      <h1 class="rb-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="rb-hero__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="rb-hero__cta">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Redbubble hero",
  "tag": "section",
  "class": "rb-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Certified OG Fan"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Cult movies. Music. Internet references. Find artist-made designs for the culturally obsessed."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Pop Culture"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Redbubble hero",
      "category": "Banners"
    }
  ]
}
{% endschema %}
