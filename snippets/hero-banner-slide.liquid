{%- doc -%}
  Renders a single hero banner slide.

  @param {object} block - The slide block
  @param {object} section - The hero banner section
  @param {number} block_index - Zero-based slide index
{%- enddoc -%}

{% liquid
  assign block_settings = block.settings
  assign section_index = section.index

  assign loading = 'lazy'
  assign fetchpriority = 'auto'
  if block_index == 0 and section_index <= 3
    assign loading = 'eager'
    assign fetchpriority = 'high'
  endif
%}

{% capture slide_content %}
  <div class="hero-banner__slide-inner">
    <div class="hero-banner__media">
      {%- if block_settings.toggle_overlay -%}
        {% render 'overlay', settings: block_settings, layer: 'var(--layer-base)' %}
      {%- endif -%}

      {%- if block_settings.media_type == 'video' and block_settings.video != blank -%}
        {%- if block_settings.video.preview_image -%}
          {{
            block_settings.video.preview_image
            | image_url: width: 1920
            | image_tag:
              class: 'hero-banner__poster',
              loading: loading,
              fetchpriority: fetchpriority,
              sizes: '100vw',
              widths: '832, 1200, 1600, 1920, 2560'
          }}
        {%- endif -%}
        {{
          block_settings.video
          | video_tag:
            poster: nil,
            autoplay: true,
            loop: true,
            controls: false,
            muted: true,
            class: 'hero-banner__video'
        }}
      {%- elsif block_settings.image != blank -%}
        {{
          block_settings.image
          | image_url: width: 2560
          | image_tag:
            class: 'hero-banner__image',
            loading: loading,
            fetchpriority: fetchpriority,
            sizes: '100vw',
            widths: '832, 1200, 1600, 1920, 2560, 3840'
        }}
      {%- else -%}
        {%- liquid
          assign modulo = block_index | modulo: 2
          assign placeholder_variant = 2 | minus: modulo
          assign placeholder_name = 'hero-apparel-' | append: placeholder_variant
        -%}
        {{ placeholder_name | placeholder_svg_tag: 'hero-banner__placeholder' }}
      {%- endif -%}
    </div>

    <div
      class="hero-banner__content hero-banner__content--align-{{ block_settings.content_alignment }} hero-banner__content--pos-{{ block_settings.content_position }}"
      {{ block.shopify_attributes }}
    >
      <div class="hero-banner__content-box">
        {%- if block_settings.eyebrow != blank -%}
          <p class="hero-banner__eyebrow">{{ block_settings.eyebrow }}</p>
        {%- endif -%}

        {%- if block_settings.heading != blank -%}
          <h2 class="hero-banner__heading">{{ block_settings.heading }}</h2>
        {%- endif -%}

        {%- if block_settings.subheading != blank -%}
          <p class="hero-banner__subheading">{{ block_settings.subheading }}</p>
        {%- endif -%}

        {%- if block_settings.button_label != blank -%}
          <a
            {% if block_settings.button_link != blank %}
              href="{{ block_settings.button_link }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
            class="hero-banner__button"
            {% if block_settings.open_in_new_tab %}
              target="_blank"
              rel="noopener noreferrer"
            {% endif %}
          >
            <span>{{ block_settings.button_label }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
{% endcapture %}

{% render 'slideshow-slide',
  index: block_index,
  children: slide_content,
  slide_size: section.settings.slide_height,
  navigate_to_slide: false
%}
