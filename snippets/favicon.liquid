{%- if settings.favicon != blank -%}
  <link
    rel="icon"
    type="image/png"
    href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
  >
{%- elsif settings.logo != blank -%}
  <link
    rel="icon"
    type="image/png"
    href="{{ settings.logo | image_url: width: 32, height: 32 }}"
  >
{%- else -%}
  <link
    rel="icon"
    type="image/svg+xml"
    href="{{ 'favicon.svg' | asset_url }}"
  >
{%- endif -%}
